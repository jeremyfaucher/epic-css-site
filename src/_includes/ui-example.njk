{% macro example(markup, label="UI example", script="", fullWidth=false, codeId="", copyNotice="", collapsible=false) %}
<section class="my-24" data-example aria-label="{{ label }}">
  <div class="{{ 'w-100' if fullWidth else 'p-24 clr-secondary-bg border-r-16' }}" data-example-preview>{{ markup | safe }}</div>
  {% if fullWidth %}<div class="wrapper"><div class="container">{% endif %}
  {% if collapsible %}<details data-example-details class="mt-16">
    <summary class="btn btn-secondary py-8 px-12">Show code</summary>{% endif %}
  <div data-example-code{% if codeId %} id="{{ codeId }}"{% endif %}>
  <div class="flex flex-wrap items-center gap-12 py-12">
    <span class="fs-14">HTML</span>
    <button class="btn btn-secondary py-8 px-12" type="button" data-copy-example>Copy HTML</button>
    <span class="clr-secondary fs-14" role="status" data-copy-feedback></span>
  </div>
  <pre class="m-0 p-16 fs-14 lh-24"><code class="language-html">{{ markup | trim | escape }}</code></pre>
  {% if copyNotice %}
  <template data-example-copy-notice>{{ copyNotice | escape }}</template>
  <div data-example-copy-fallback hidden>
    <p class="fs-14">Complete HTML, including the consolidated license notice:</p>
    <textarea class="w-100" readonly rows="8" aria-label="Complete HTML with license notice" data-example-copy-source></textarea>
  </div>
  {% endif %}
  {% if script %}
  <div class="flex flex-wrap items-center gap-12 py-12">
    <span class="fs-14">JavaScript</span>
    <button class="btn btn-secondary py-8 px-12" type="button" data-copy-example data-copy-language="javascript">Copy JavaScript</button>
  </div>
  <pre class="m-0 p-16 fs-14 lh-24"><code class="language-javascript">{{ script | trim | escape }}</code></pre>
  {% endif %}
  </div>
  {% if collapsible %}</details>{% endif %}
  {% if fullWidth %}</div></div>{% endif %}
</section>
{% endmacro %}
