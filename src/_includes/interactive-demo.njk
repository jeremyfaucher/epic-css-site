</style></head><body><main class="shell"><div class="intro"><div><div class="eyebrow">Epic CSS / interactive tour</div><h1>Build the site. Build the styles.</h1><p>Try a miniature development workflow. Explore real project scripts, run simulated commands, and see a simplified Eleventy theme preview come to life.</p></div><div class="pill">Interactive prototype · no installation</div></div><section class="workspace" aria-label="Simulated development workspace"><header class="topbar"><div class="dots" aria-hidden="true"><i></i><i></i><i></i></div><strong>epic-css-11ty-theme</strong><small>GUIDED WORKSPACE</small></header><div class="panes"><nav class="explorer" aria-label="Project files"><div class="panel-label">EXPLORER</div><div id="files"></div></nav><section class="editor" aria-label="Code editor"><div class="tab" id="tab">package.json</div><pre class="code" id="code"></pre><div class="terminal"><div class="terminal-head">TERMINAL — SIMULATED</div><pre id="terminal" aria-live="polite"></pre></div></section><section class="preview-col" aria-label="Website preview"><div class="preview-head"><span>◀ &nbsp; ▶</span><div class="url">localhost:8080 · theme preview</div></div><div class="preview-body" id="preview"></div></section></div><div class="controls"><div class="steps" id="steps"></div><div class="control-row"><div><h3 id="stage-title"></h3><p id="stage-desc"></p></div><div class="actions"><button class="action" id="back">← Back</button><button class="action primary" id="next">Run step →</button><button class="action" id="reset">Reset</button></div></div><div class="note">This is a safe, scripted simulation, not a shell or actual build. Epic Build and Epic Light outputs are illustrative until verified against the package. The preview is an original simplified recreation, not a screenshot of the live theme.</div></div></section></main><script>
const scripts={"prestart":"sass src/my-epic-css/index.scss src/_includes/style.css","start":"npm-run-all --parallel watch:*","watch:start":"eleventy --serve","build-production":"eleventy","watch:sass":"sass --watch src/my-epic-css/index.scss:src/_includes/style.css","epic-build":"node ./node_modules/epic-css/src/epic-build.js","epic-light":"node ./node_modules/epic-css/src/epic-light.js"};
const files={"package.json":()=>JSON.stringify({scripts},null,2),"src/my-epic-css/index.scss":()=>`// Your Sass entry point\n// Edit the site's Sass here.\n\n@use "sass:color";\n\n// Epic CSS imports and customization\n// are project-specific.`,"src/_includes/style.css":()=>state>=1?`/* Compiled by Sass prestart / watch:sass */\n/* This preview shows illustrative CSS. */\nbody { font-family: system-ui, sans-serif; }\n.site-layout { display: grid; }`:`/* Stylesheet will be compiled by Sass. */`,"src/index.njk":()=>`{% extends "layouts/base.njk" %}\n{% block content %}\n  <h1>Content and layout, kept in step.</h1>\n  <p>A sample Eleventy website.</p>\n{% endblock %}`,"_site/index.html":()=>state>=1?`<!doctype html>\n<html lang="en">\n  <head><title>Eleventy theme</title></head>\n  <body>\n    <h1>Content and layout, kept in step.</h1>\n  </body>\n</html>`:`// Generated when Eleventy runs.`};
const stages=[{label:'Explore',title:'Two tools, one website',desc:'Eleventy generates your pages. Epic CSS has separate CSS build commands.',file:'package.json',terminal:'$ # Explore the scripts in package.json',preview:0,button:'Run npm start →'},{label:'Start Eleventy',title:'Start your development site',desc:'npm start runs prestart Sass compilation, then Eleventy serve and Sass watch in parallel.',file:'package.json',terminal:'$ npm start\n> prestart: sass src/my-epic-css/index.scss src/_includes/style.css\n> start: npm-run-all --parallel watch:*\n> watch:start: eleventy --serve\n> watch:sass: sass --watch src/my-epic-css/index.scss:src/_includes/style.css\n✓ Development site available (simulated)',preview:1,button:'Run epic-build →'},{label:'Epic Build',title:'Run the Epic CSS build',desc:'The package script invokes epic-build.js. Exact generated files and messages require verification.',file:'src/_includes/style.css',terminal:'$ npm run epic-build\n> node ./node_modules/epic-css/src/epic-build.js\n[Simulation] Epic build script invoked.\n[Output details pending verification.]',preview:2,button:'Run epic-light →'},{label:'Epic Light',title:'Explore the lightweight build',desc:'Epic Light is a separate package script. This demo preserves the preview instead of inventing a visual change.',file:'package.json',terminal:'$ npm run epic-light\n> node ./node_modules/epic-css/src/epic-light.js\n[Simulation] Epic Light script invoked.\n[Output size and files pending verification.]',preview:2,button:'Run production build →'},{label:'Production',title:'Build the Eleventy site for production',desc:'npm run build-production invokes Eleventy. Deploy the resulting site using your project configuration.',file:'_site/index.html',terminal:'$ npm run build-production\n> eleventy\n[Simulation] Eleventy production build invoked.',preview:2,button:'Restart tour ↺'}];
let state=0,selected='package.json';const $=id=>document.getElementById(id);function escapeHTML(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}function showCode(){const lines=files[selected]().split('\n');$('tab').textContent=selected;$('code').innerHTML=lines.map((line,i)=>`<span class="ln">${i+1}</span>${escapeHTML(line)}`).join('\n');}function sample(){return `<div class="sample ${state===1?'unstyled':''}"><div class="sample-nav"><b>Eleventy Theme</b><span>Home &nbsp; Blog &nbsp; About</span></div><div class="sample-main"><h2>Content and layout,<br>kept in step.</h2><p>A clean starter for content-focused websites.</p><div class="sample-grid"><article class="post"><strong>Latest from the blog</strong><p>Build pages with Eleventy and style them with Epic CSS.</p><a href="#" onclick="return false">Read the article →</a><br><span class="tag">Getting started</span></article><aside class="sidebar"><strong>Categories</strong><p>Design</p><p>Development</p><p>Guides</p></aside></div></div></div>`}function render(){const s=stages[state];$('files').innerHTML=Object.keys(files).map(f=>`<button class="file ${f===selected?'active':''}" data-file="${escapeHTML(f)}"><span class="symbol">${f.startsWith('_site')?'◇':'▤'}</span>${escapeHTML(f)}</button>`).join('');document.querySelectorAll('[data-file]').forEach(b=>b.addEventListener('click',()=>{selected=b.dataset.file;render()}));showCode();$('terminal').textContent=s.terminal;$('preview').innerHTML=s.preview?sample():`<div class="preview-placeholder"><div><b>Preview not running</b>Run <code>npm start</code> to start the simulated Eleventy development site.</div></div>`;$('steps').innerHTML=stages.map((x,i)=>`<button class="step ${i===state?'active':''} ${i<state?'done':''}" data-step="${i}">${i+1}. ${x.label}</button>`).join('');document.querySelectorAll('[data-step]').forEach(b=>b.addEventListener('click',()=>{state=Number(b.dataset.step);selected=stages[state].file;render()}));$('stage-title').textContent=s.title;$('stage-desc').textContent=s.desc;$('back').disabled=state===0;$('next').textContent=s.button;}$('back').addEventListener('click',()=>{state=Math.max(0,state-1);selected=stages[state].file;render()});$('next').addEventListener('click',()=>{state=(state+1)%stages.length;selected=stages[state].file;render()});$('reset').addEventListener('click',()=>{state=0;selected='package.json';render()});render();
</script>
