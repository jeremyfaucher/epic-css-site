{%- if tag == 'home-page' -%}
<title>{{ site.name | escape }} - {{ title | escape }}</title>
{%- else -%}
<title>{{ (seoTitle or title) | escape }} - {{ site.name | escape }}</title>
{%- endif %}
<meta name="description" content="{{ description | escape }}">
<link rel="canonical" href="{{ site.url }}{{ page.url | escape }}">
