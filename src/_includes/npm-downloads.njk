<div class="npm-downloads">
  <div class="npm-downloads-heading">
    <svg width="16" height="16" viewBox="0 0 24 24"
         fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <path d="m7 10 5 5 5-5"/>
      <path d="M12 15V3"/>
    </svg>
    <span>EPIC CSS · NPM DOWNLOADS</span>
  </div>
  <strong id="total-downloads">—</strong>
  <span class="npm-downloads-label">Total downloads</span>
  <div class="npm-downloads-divider"></div>
  <strong id="weekly-downloads">—</strong>
</div>

<style>

.npm-downloads {
  box-sizing: border-box;
  width: 100%;
  max-width: 312px;
  padding: 20px 14px 16px;
  background: #090909;
  color: #f5f5f5;
  border: 1px solid #303030;
  border-radius: 16px;
  font-family: Arial, sans-serif;
  line-height: 1.3;
}

.npm-downloads-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
  font-size: 13px;
  font-weight: 600;
  color: #d4d4d4;
  white-space: nowrap;
}

.npm-downloads-heading svg {
  flex-shrink: 0;
}

#total-downloads {
  display: block;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.npm-downloads-label {
  display: block;
  margin-top: 6px;
  font-size: 14px;
  color: #d4d4d4;
}

.npm-downloads-divider {
  height: 1px;
  background: #303030;
  margin: 10px 0 14px;
}

#weekly-downloads {
  display: block;
  font-size: 16px;
  font-weight: 700;
  color: #f5f5f5;
}

/* Responsive */
@media (max-width: 768px) {
  .npm-downloads {
    width: 100%;
    max-width: 312px;
  }
}

</style>



<script>


async function getEpicCSSDownloads() {
  const packageName = "epic-css";
  const startDate = "2025-01-01";

  // Use yesterday to avoid counting a partial day.
  const yesterday = new Date();
  yesterday.setUTCDate(yesterday.getUTCDate() - 1);
  const endDate = yesterday.toISOString().slice(0, 10);

  const api = "https://api.npmjs.org/downloads";

  // Fetch historical downloads in yearly chunks.
  let total = 0;
  let cursor = new Date(`${startDate}T00:00:00Z`);
  const end = new Date(`${endDate}T00:00:00Z`);

  while (cursor <= end) {
    const chunkStart = cursor.toISOString().slice(0, 10);

    const chunkEnd = new Date(cursor);
    chunkEnd.setUTCFullYear(chunkEnd.getUTCFullYear() + 1);
    chunkEnd.setUTCDate(chunkEnd.getUTCDate() - 1);

    if (chunkEnd > end) chunkEnd.setTime(end.getTime());

    const to = chunkEnd.toISOString().slice(0, 10);
    const url = `${api}/range/${chunkStart}:${to}/${packageName}`;

    const response = await fetch(url);
    if (!response.ok) throw new Error("Failed to fetch npm history");

    const data = await response.json();
    total += data.downloads.reduce(
      (sum, day) => sum + day.downloads, 0
    );

    cursor = new Date(chunkEnd);
    cursor.setUTCDate(cursor.getUTCDate() + 1);
  }

  const weeklyResponse = await fetch(
    `${api}/point/last-week/${packageName}`
  );

  if (!weeklyResponse.ok) {
    throw new Error("Failed to fetch weekly downloads");
  }

  const weekly = await weeklyResponse.json();

  return {
    total,
    weekly: weekly.downloads
  };
}

getEpicCSSDownloads()
  .then(({ total, weekly }) => {
    document.querySelector("#total-downloads").textContent =
      total.toLocaleString();

document.querySelector("#weekly-downloads").textContent =
  `+${weekly.toLocaleString()} last 7 days`;

  })
  .catch(console.error);


</script>
