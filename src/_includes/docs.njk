---
layout: base.njk
---
<div class="grid grid-sidebar-left-lg-208px gap-32 pt-24">
  <aside class="docs-sidebar">
    <nav aria-label="Documentation">
      <p class="docs-nav-heading clr-secondary fs-14 fw-600 mb-8">Getting started</p>
      <ul class="list-none m-0 mb-20 p-0 flex flex-wrap gap-4">
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/"{% if docTopic == "overview" %} aria-current="page"{% endif %}>Overview</a></li>
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/installation/"{% if docTopic == "installation" %} aria-current="page"{% endif %}>Installation</a></li>
      </ul>
      <p class="docs-nav-heading clr-secondary fs-14 fw-600 mb-8">Layout</p>
      <ul class="list-none m-0 mb-20 p-0 flex flex-wrap gap-4">
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/wrapper-and-container/"{% if docTopic == "wrapper-and-container" %} aria-current="page"{% endif %}>Wrapper and container</a></li>
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/flexbox/"{% if docTopic == "flexbox" %} aria-current="page"{% endif %}>Flexbox</a></li>
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/grid/"{% if docTopic == "grid" %} aria-current="page"{% endif %}>Grid</a></li>
      </ul>
      <p class="docs-nav-heading clr-secondary fs-14 fw-600 mb-8">Styling</p>
      <ul class="list-none m-0 mb-20 p-0 flex flex-wrap gap-4">
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/typography/"{% if docTopic == "typography" %} aria-current="page"{% endif %}>Typography</a></li>
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/colors/"{% if docTopic == "colors" %} aria-current="page"{% endif %}>Colors and palettes</a></li>
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/images/"{% if docTopic == "images" %} aria-current="page"{% endif %}>Images</a></li>
      </ul>
      <p class="docs-nav-heading clr-secondary fs-14 fw-600 mb-8">Project</p>
      <ul class="list-none m-0 mb-20 p-0 flex flex-wrap gap-4">
        <li><a class="clr-secondary py-8 px-12 border-r-4" href="/docs/changelog/"{% if docTopic == "changelog" %} aria-current="page"{% endif %}>Changelog</a></li>
      </ul>
    </nav>
  </aside>
  <article class="docs-article" id="docs-content" data-doc-topic="{{ docTopic }}">
    <p class="docs-eyebrow clr-secondary fs-14 mb-8">Epic CSS / Documentation</p>
    {{ content | safe }}
  </article>
</div>
<script src="/assets/js/docs.js" defer></script>
<script src="/assets/js/examples.js" defer></script>
