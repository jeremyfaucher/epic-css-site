<footer class="container flex justify-between my-40">
<div class="flex flex-col-reverse md-flex-row gap-80">
<div class="copyright">
<p class="fs-12 lh-16">Epic CSS © All Rights Reserved 2026<br>Website by <a href="https://design2seo.com/">Design 2 SEO</a>
</p>
</div>
<nav aria-label="Sitemap">
<div class="flex flex-wrap gap-40">
{% for group in collections.footerSitemap %}
<div>
<ul class="fs-16 list-none" aria-label="{{ group.title }}">
{% for item in group.pages %}
<li class="mb-12">
<a href="{{ item.url }}"{% if page.url == item.url %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
</li>
{% endfor %}
</ul>
</div>
{% endfor %}
</div>
</nav>
</div>
</footer>
