{% macro image(card, classes, imageClasses="") -%}
<a href="{{ card.href }}" class="{{ classes }}"><img class="border-r-16 mb-0{% if imageClasses %} {{ imageClasses }}{% endif %}" src="{{ card.image }}" alt="{{ card.alt }}" width="{{ card.width }}" height="{{ card.height }}"></a>
{%- endmacro %}

{% macro content(card) -%}
<h3 class="clr-primary mt-0 mb-24">
    <a href="{{ card.href }}">{{ card.title }}</a>
</h3>
<div class="mb-24">
<span>{{ card.category }}</span> · <span>{{ card.topic }}</span>
</div>
<p class="mb-0">
{{ card.excerpt | escape }}
<a href="{{ card.href }}" class="clr-underline">{{ card.linkLabel }}</a></p>
{%- endmacro %}
