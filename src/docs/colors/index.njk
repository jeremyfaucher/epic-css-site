<h1 id="colors">Colors and palettes</h1>
<p class="docs-lead">Choose colors by their role in your design. Text and background utilities are separate, so one palette can change the appearance of the same markup.</p>
<h2 id="color-utilities">Text and backgrounds</h2>
{% set markup %}<div class="clr-primary-bg p-24 border-r-16">
  <p class="clr-primary">Primary text on the primary background.</p>
  <p>This paragraph inherits the body text color.</p>
</div>{% endset %}
{{ example(markup, "Primary text and background") }}
{% set markup %}<div class="clr-secondary-bg p-24 border-r-16">
  <p class="clr-secondary">Secondary text on the secondary background.</p>
  <p class="clr-white">White text stays white when the palette changes.</p>
</div>{% endset %}
{{ example(markup, "Secondary text and background") }}
